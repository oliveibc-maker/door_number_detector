# ── Google Street View ─────────────────────────────────────────────────────────
# Get your API key from: https://developers.google.com/maps/documentation/streetview/get-api-key
GOOGLE_API_KEY=your_key_here

# Optional: override image size (default: 640x640)
# STREET_VIEW_SIZE=640x640

# ── Detection ──────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=99
DEBUG=False

# ── Web server ─────────────────────────────────────────────────────────────────
# True = run in the background (logs → server.log / server_error.log)
# False = run in foreground (logs visible in terminal)
RUN_IN_BACKGROUND=True

# ── Network ───────────────────────────────────────────────────────────────────
# The web server requires credentials and binds to loopback by default.
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_USERNAME=
WEB_PASSWORD=
# Upload limit in bytes (default: 26214400, or 25 MiB).
MAX_UPLOAD_BYTES=26214400
APP_DATA_DIR=./data
# DATABASE_PATH defaults to door_detector.db in the current working directory.
# CLI source selection:
SOURCE=sqlserver
FILTER_BY=rua
FILTER_VALUE=
# INPUT_EXCEL=./input.xlsx
# Use a long random password. Keep the app on loopback behind a same-host HTTPS proxy.
# Optional: HTTP proxy for Street View API requests
# HTTPS_PROXY=http://your-proxy:port

# ── Source database (SQL Server — required for SQL Server batch mode) ──────────
SRC_DB_SERVER=
SRC_DB_DATABASE=GEO_DB
SRC_DB_DRIVER=ODBC Driver 17 for SQL Server
# Windows Auth (default):
SRC_DB_TRUSTED=True
# SQL Auth (set SRC_DB_TRUSTED=False and fill these):
# SRC_DB_USER=
# SRC_DB_PASSWORD=
# ODBC Driver 18 encrypts by default; a self-signed server certificate needs a trusted CA,
# or (less safe) SRC_DB_TRUST_SERVER_CERTIFICATE=True. Leave both unset for driver defaults.
# SRC_DB_ENCRYPT=True
# SRC_DB_TRUST_SERVER_CERTIFICATE=False

# ── Output database (SQLite by default — no setup required) ────────────────────
# DATABASE_TYPE=sqlite
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_NAME=door_detector
