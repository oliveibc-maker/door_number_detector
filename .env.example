# Google API Configuration
# Get your API key from: https://developers.google.com/maps/documentation/streetview/get-api-key
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Override Street View image size (default: 640x480)
# STREET_VIEW_SIZE=640x480

# Optional: Database configuration (defaults to SQLite)
# DATABASE_TYPE=sqlite
# DATABASE_HOST=localhost
# DATABASE_PORT=1521
# DATABASE_USER=system
# DATABASE_PASSWORD=
# DATABASE_NAME=door_detector
# DATABASE_SID=xe

# Optional: OCR Configuration
# TESSERACT_PATH=/usr/bin/tesseract
# OCR_LANGUAGE=por+eng
# CONFIDENCE_THRESHOLD=70

# Optional: Application settings
# DEBUG=False
# LOG_LEVEL=INFO
# MAX_RETRIES=3
