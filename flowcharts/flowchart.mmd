    M -->|Yes| J
    M -->|No| N["Record no prediction"]
    L -->|Yes| O["PaddleOCR on full image, 2x upscaled"]
    O --> P["Parse and score OCR candidates"]
    P --> Q{"Confident result?"}
    Q -->|No or early-stop suppressed| M
    Q -->|Yes| R["Select prediction"]
    I --> S["Return result; persist in SQLite when applicable"]
    N --> S
    R --> S
    S --> T["Compare expected and detected values"]
    T --> U["Append CSV row"]
    U --> V{"More source rows?"}
    V -->|Yes| F
    V -->|No| W["Write run metrics"]
    W --> X["APP_DATA_DIR/outputs"]
    X --> Y["Web dashboard reads status and results"]